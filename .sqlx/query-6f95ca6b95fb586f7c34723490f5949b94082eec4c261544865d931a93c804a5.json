  "query": "\n            UPDATE users\n            SET\n                username = COALESCE($1, username),\n                email = $2,\n                role = $3,\n                password = COALESCE($4, password),\n                updated_at = $5\n            WHERE id = $6\n            RETURNING\n                id,\n                username,\n                password AS \"password!\",\n                email,\n                role AS \"role: Role\",\n                otp_secret,\n                created_at,\n                updated_at\n            ",
