{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                id,\n                user_id,\n                remote_address,\n                user_agent,\n                created_at,\n                updated_at,\n                expires_at\n            FROM sessions\n            WHERE\n                user_id = $1\n            AND (expires_at IS NULL OR expires_at > $2)\n            ORDER BY created_at DESC\n            ",
