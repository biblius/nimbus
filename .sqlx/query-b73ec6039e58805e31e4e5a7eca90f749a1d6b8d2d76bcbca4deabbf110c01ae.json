  "query": "\n            SELECT\n                u.id,\n                u.username,\n                u.email,\n                u.role AS \"role: Role\",\n                u.created_at\n            FROM user_folders uf\n            JOIN users u ON uf.user_id = u.id\n            WHERE root_id = $1\n            ORDER BY username\n            ",
