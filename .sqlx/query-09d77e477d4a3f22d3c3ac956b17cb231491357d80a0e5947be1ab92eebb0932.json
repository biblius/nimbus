  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                id,\n                name,\n                quota_bytes AS quota,\n                owner,\n                created_at,\n                updated_at\n            FROM roots\n            WHERE owner = $1\n            OR id IN (\n                 SELECT root_id\n                 FROM user_folders\n                 WHERE user_id = $1\n            )\n            ORDER BY owner IS NULL, name\n            ",
