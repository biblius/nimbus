# Load into the current shell: `source setup.sh` (not `./setup.sh`).

ADDRESS=0.0.0.0:8080
RUST_LOG=info,sqlx=off,h2=off,nimbus_server=debug

# postgres feature (default). Configured for docker-compose.
DATABASE_URL=postgres://nimbus:nimbus@127.0.0.1:5434/nimbus

# sqlite feature
# DATABASE_URL=sqlite://./data/nimbus.db?mode=rwc

# valkey feature (default). Valkey speaks the Redis protocol.
VALKEY_URL=redis://127.0.0.1:6379

UPLOAD_DIR=./data
FILE_RETENTION_DAYS=30
FILE_DELETION_INTERVAL_SECS=30
UPLOAD_MAX_BYTES=1073741824

COOKIE_NAME=nimbus_session
COOKIE_DOMAIN=
COOKIE_SECURE=false
CSRF_HEADER=X-NIMBUS-CSRF
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:1420,http://tauri.localhost,https://tauri.localhost,tauri://localhost
CORS_ALLOWED_HEADERS=Authorization,Content-Type,Accept,X-NIMBUS-CSRF,X-Requested-With

# Gmail SMTP. Leave the password empty to disable sending.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
MAIL_FROM_NAME=Nimbus
FRONTEND_URL=http://localhost:5173
