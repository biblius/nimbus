# Load into the current shell: `source setup.sh` (not `./setup.sh`).

###### NIMBUS SERVER #########

# Server listen address and port
ADDRESS=0.0.0.0:8080

RUST_LOG=info,sqlx=off,h2=off,nimbus_server=debug

# When using postgres (feature sqlite).
# Default for docker-compose and the recommended setup.
DATABASE_URL=postgres://nimbus:nimbus@127.0.0.1:5434/nimbus

# When using sqlite (feature sqlite).
# DATABASE_URL=sqlite://./data/nimbus.db?mode=rwc

# Used for one-shot tokens and ephemeral data (feature valkey).
VALKEY_URL=redis://127.0.0.1:6379

# Data (BLOB, preview) directory.
UPLOAD_DIR=./data

# Generated preview images.
PREVIEW_DIR=./preview

# Ephemeral files (uploads in progress, zip downloads).
# Defaults to the system temp dir, or ./tmp if that is unavailable.
# TMP_DIR=/tmp

# 10 GiB
UPLOAD_MAX_BYTES=1073741824

# How long to keep files in trash.
FILE_RETENTION_DAYS=30

# Interval at which expired trash is hard-deleted.
FILE_DELETION_INTERVAL_SECS=30

# Session cookie configuration.
COOKIE_NAME=nimbus_session
COOKIE_DOMAIN=
COOKIE_SECURE=true

# Cors configuration.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:1420,http://tauri.localhost,https://tauri.localhost,tauri://localhost
CORS_ALLOWED_HEADERS=Authorization,Content-Type,Accept,X-Requested-With

# Gmail SMTP. Leave the password empty to disable sending.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Email sender name.
MAIL_FROM_NAME=Nimbus

# Used for email templates.
FRONTEND_URL=http://localhost:5173

# Relying party ID and origin, for passkey setup.
# RP_ID must be an effective domain in RP_ORIGIN
# e.g. if ORIGIN is nimbus.my.org, RP_ID must be one of
# `nimbus.my.org`, `my.org`, or `org`.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_ORIGIN=http://localhost:5173

###### NIMBUS WEB #########

# Server API URL.
VITE_NIMBUS_URL=http://localhost:42069
