{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for the Nimbus desktop and mobile shell",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "sql:default",
    "sql:allow-load",
    "sql:allow-select",
    "sql:allow-execute",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://*:*/**" },
        { "url": "https://*:*/**" },
        { "url": "http://*/**" },
        { "url": "https://*/**" }
      ]
    }
  ]
}
