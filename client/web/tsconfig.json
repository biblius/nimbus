{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "types": ["svelte", "vite/client", "vite-plugin-pwa/client"],
    "paths": {
      "@nimbus/lib/*": ["../shared/src/lib/*"]
    }
  },
  "include": ["src"]
}
