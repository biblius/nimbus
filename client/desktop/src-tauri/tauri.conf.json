{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nimbus",
  "version": "0.1.0",
  "identifier": "dev.nimbus.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nimbus",
        "width": 1100,
        "height": 760
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    },
    "sql": {
      "preload": ["sqlite:nimbus.db"]
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEwRkQyMzU4MUU0M0YyRjIKUldUeThrTWVXQ1A5RUFjY0NyOHN4dldVM1lwRFhpY0V3WG9oYVk1OUxvcVpPVERuZW10aVBIUEoK",
      "endpoints": [
        "https://github.com/biblius/nimbus/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "basicUi"
      }
    }
  }
}
